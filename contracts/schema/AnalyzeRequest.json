        "length"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "Flags": {
      "additionalProperties": false,
      "description": "BE đọc từ DynamoDB CONFIG#global/FLAGS (ARCH §5.8), cache 30 giây, gửi trong AnalyzeContext.",
      "properties": {
        "feature_image": {
          "default": true,
          "title": "Feature Image",
          "type": "boolean"
        },
        "feature_rag": {
          "default": true,
          "title": "Feature Rag",
          "type": "boolean"
        },
        "feature_voice": {
          "default": true,
          "title": "Feature Voice",
          "type": "boolean"
        },
        "llm_enabled": {
          "default": true,
          "title": "Llm Enabled",
          "type": "boolean"
        }
      },
      "title": "Flags",
      "type": "object"
    },
    "InboundMessage": {
      "additionalProperties": false,
