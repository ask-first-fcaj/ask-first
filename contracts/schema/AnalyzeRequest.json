  "properties": {
    "ctx": {
      "$ref": "#/definitions/AnalyzeContext"
    },
    "items": {
      "items": {
        "$ref": "#/definitions/InboundMessage"
      },
      "title": "Items",
      "type": "array"
    },
    "op": {
      "const": "analyze",
      "default": "analyze",
      "title": "Op",
      "type": "string"
    },
    "session": {
      "$ref": "#/definitions/SessionContext",
      "default": null
    },
    "v": {
      "default": "1.0",
      "title": "V",
      "type": "string"
    }
  },
  "required": [
    "ctx"
  ],
  "title": "AnalyzeRequest",
  "type": "object"
}
