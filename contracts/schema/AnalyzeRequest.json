        "media_group_id": {
          "default": null,
          "title": "Media Group Id",
          "type": "string"
        },
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "text": {
          "default": null,
          "title": "Text",
          "type": "string"
        },
        "update_id": {
          "title": "Update Id",
          "type": "string"
        },
        "user_id": {
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "update_id",
        "chat_id",
        "user_id",
        "message_id",
        "kind",
        "received_at"
