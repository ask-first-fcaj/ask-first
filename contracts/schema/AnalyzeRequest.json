    "SessionContext": {
      "additionalProperties": false,
      "description": "Lượt hỏi thêm (ARCH §6.12). BE lấy từ SESSION# rồi gửi trong AnalyzeRequest, AI ghép vào Judge. Có qua wire.",
      "properties": {
        "answer": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "Answer",
          "type": "string"
        },
        "masked_text": {
          "title": "Masked Text",
          "type": "string"
        },
        "prev_check_id": {
          "title": "Prev Check Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "turn": {
          "maximum": 2,
          "minimum": 1,
          "title": "Turn",
          "type": "integer"
        }
      },
      "required": [
        "prev_check_id",
        "masked_text",
        "question",
        "answer",
        "turn"
      ],
      "title": "SessionContext",
      "type": "object"
