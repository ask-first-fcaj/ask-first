{"id": "bn-ai-01", "split": "benign_normal", "input": {"text": "Minh ơi, cuối tuần này t về đi cafe với m, m mua giùm t nồi lẩu nha, ae mình ngồi ăn", "entities": [], "image": null, "audio": null, "forward_origin": null}, "label": {"is_scam": false, "group": "N0", "scenario": "N0", "min_level": null, "max_level": "UNSURE", "must_signals": [], "risky_actions": []}, "source_url": null, "author": "thiendt1608", "notes": "nguồn gốc: dựng theo định dạng"}
{"id": "bn-ai-02", "split": "benign_normal", "input": {"text": "Ông nội ơi, con mới thi xong hôm qua, bài thi cũng ổn.", "entities": [], "image": null, "audio": null, "forward_origin": null}, "label": {"is_scam": false, "group": "N0", "scenario": "N0", "min_level": null, "max_level": "UNSURE", "must_signals": [], "risky_actions": []}, "source_url": null, "author": "thiendt1608", "notes": "nguồn gốc: dựng theo định dạng"}
{"id": "bn-ai-03", "split": "benign_normal", "input": {"text": "Mai đi escape kh minh, tao rảnh sau 3 giờ. Rủ thêm duy luôn cho vui.", "entities": [], "image": null, "audio": null, "forward_origin": null}, "label": {"is_scam": false, "group": "N0", "scenario": "N0", "min_level": null, "max_level": "UNSURE", "must_signals": [], "risky_actions": []}, "source_url": null, "author": "thiendt1608", "notes": "nguồn gốc: dựng theo định dạng"}
{"id": "bn-ai-04", "split": "benign_normal", "input": {"text": "Tối nay mình xem phim nha? Anh đặt ghế rồi, 7 giờ a qua chở. Em nhớ mang áo khoác nha.", "entities": [], "image": null, "audio": null, "forward_origin": null}, "label": {"is_scam": false, "group": "N0", "scenario": "N0", "min_level": null, "max_level": "UNSURE", "must_signals": [], "risky_actions": []}, "source_url": null, "author": "thiendt1608", "notes": "nguồn gốc: dựng theo định dạng"}
{"id": "bn-ai-05", "split": "benign_normal", "input": {"text": "Nhắc nhẹ: 9h sáng mai họp nhóm ở phòng 302, nhớ mang laptop và bản báo cáo tuần nhé.", "entities": [], "image": null, "audio": null, "forward_origin": null}, "label": {"is_scam": false, "group": "N0", "scenario": "N0", "min_level": null, "max_level": "UNSURE", "must_signals": [], "risky_actions": []}, "source_url": null, "author": "thiendt1608", "notes": "nguồn gốc: dựng theo định dạng"}
{"id": "bn-ai-06", "split": "benign_normal", "input": {"text": "Mẹ ơi, trưa nay con họp đột xuất nên không về ăn cơm được. Ba mẹ ăn trước đi nha", "entities": [], "image": null, "audio": null, "forward_origin": null}, "label": {"is_scam": false, "group": "N0", "scenario": "N0", "min_level": null, "max_level": "UNSURE", "must_signals": [], "risky_actions": []}, "source_url": null, "author": "thiendt1608", "notes": "nguồn gốc: dựng tự nhiên"}
{"id": "bn-ai-07", "split": "benign_normal", "input": {"text": "Tối nay rảnh không m, qua quán nước gần trường đi. T với thằng Nam ngồi từ 6 rưỡi rồi", "entities": [], "image": null, "audio": null, "forward_origin": null}, "label": {"is_scam": false, "group": "N0", "scenario": "N0", "min_level": null, "max_level": "UNSURE", "must_signals": [], "risky_actions": []}, "source_url": null, "author": "thiendt1608", "notes": "nguồn gốc: dựng tự nhiên"}
{"id": "bn-ai-08", "split": "benign_normal", "input": {"text": "Cậu cho tớ xin file slide thuyết trình nhóm môn Triết với, máy tớ mới cài lại win nên mất rồi.", "entities": [], "image": null, "audio": null, "forward_origin": null}, "label": {"is_scam": false, "group": "N0", "scenario": "N0", "min_level": null, "max_level": "UNSURE", "must_signals": [], "risky_actions": []}, "source_url": null, "author": "thiendt1608", "notes": "nguồn gốc: dựng tự nhiên"}
